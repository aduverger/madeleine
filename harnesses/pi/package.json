{
  "name": "@aduverger/madeleine-pi",
  "version": "0.1.0",
  "description": "Local-first historical context for Pi coding agents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aduverger/madeleine.git",
    "directory": "harnesses/pi"
  },
  "homepage": "https://github.com/aduverger/madeleine#readme",
  "bugs": {
    "url": "https://github.com/aduverger/madeleine/issues"
  },
  "type": "module",
  "license": "Apache-2.0",
  "author": "Alexandre Duverger",
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent",
    "memory"
  ],
  "files": [
    "commands.ts",
    "episode-tool.ts",
    "index.ts",
    "lifecycle.ts",
    "render.ts",
    "recovery.ts",
    "rpc.ts",
    "state.ts",
    "summary.ts",
    "transcript-tool.ts",
    "transcript.ts",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "pack:check": "npm_config_cache=.npm-cache npm pack --dry-run",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "22.20.1",
    "typebox": "1.3.21",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
